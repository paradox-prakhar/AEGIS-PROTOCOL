# All values are PUBLIC frontend configuration baked into the bundle. Never put secrets here.
VITE_ARC_RPC_URL=https://rpc.testnet.arc.io
VITE_ARC_EXPLORER_URL=https://explorer.testnet.arc.io
# Shared registry. Leave empty to use src/deployment.json.
VITE_REGISTRY_ADDRESS=0x5eD536a9a2856109E4a02016ad2a99B3865e91F0
# Optional: restrict the deployment button to your funded public wallet.
VITE_DEPLOYER_ADDRESS=
# Optional: pre-filled reviewer for new deployments (defaults to the reviewer in src/deployment.json).
VITE_DEFAULT_REVIEWER=

# Browser-public origin-restricted Arkiv RPC access key.
VITE_ARKIV_ACCESS_KEY=
