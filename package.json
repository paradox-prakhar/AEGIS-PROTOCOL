{
  "name": "aegis-protocol",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run contracts:compile && node scripts/copy-ocr-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/risk.test.js src/heuristics.test.js src/arkiv-validation.test.js src/test-report.test.js src/incident-crypto.test.js",
    "contracts:compile": "node scripts/compile.mjs",
    "test:contracts": "node --test scripts/contracts.test.mjs scripts/staking.test.mjs",
    "test:all": "npm test && npm run test:contracts",
    "deploy:check": "node scripts/deployment-check.mjs",
    "deploy:verify": "node scripts/verify-deployment.mjs",
    "predev": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "clsx": "^2.1.1",
    "ethers": "^6.17.0",
    "framer-motion": "^14.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "viem": "^2.57.16",
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "solc": "0.8.38",
    "tailwindcss": "^4.3.5",
    "vite": "^6.1.0",
    "hardhat": "^3.21.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "zod": "^4.6.6"
  }
}
